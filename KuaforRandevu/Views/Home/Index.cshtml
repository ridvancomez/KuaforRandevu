@{
    ViewData["Title"] = "Home Page";
}

<!-- Heading Row-->
<div class="row gx-4 gx-lg-5 align-items-center my-5">
    <div class="col-lg-7"><img class="img-fluid rounded mb-4 mb-lg-0" src="~/images/barber-image.jpg" alt="Barber Image" title="Barber Image" /></div>
    <div class="col-lg-5">
        <h1 class="font-weight-light">Rıdvan Kuaför Salonu</h1>
        <p>Profesyonel berber hizmetleri sunan modern kuaför salonumuza hoş geldiniz. Deneyimli berberlerimiz ve kaliteli ürünlerle saçınız için en iyi bakımı sunuyoruz. Online randevu sistemiyle istediğiniz zamanı seçip hemen randevu alabilirsiniz.</p>
        <a class="btn btn-primary" href="#randevu">Randevu Al</a>
    </div>
</div>
<!-- Call to Action-->
<div class="card text-white bg-secondary my-5 py-4 text-center">
    <div class="card-body"><p class="text-white m-0">Çevrimiçi randevu sistemiyle istediğiniz günü ve saati seçin. Rıdvan Kuaför'de profesyonel hizmet ve kaliteli sonuç garantili!</p></div>
</div>
<!-- Content Row-->
<!-- alttaki kısmı ya view componenet ile yapacağım -->
@await Component.InvokeAsync("ServiceList")